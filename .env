# Django Settings
SECRET_KEY=django-insecure-demo-key-for-development-only-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3

# Social Media API Keys (Demo values - replace with real API keys)
TWITTER_CONSUMER_KEY=demo-twitter-consumer-key
TWITTER_CONSUMER_SECRET=demo-twitter-consumer-secret
TWITTER_ACCESS_TOKEN=demo-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=demo-twitter-access-token-secret

FACEBOOK_APP_ID=demo-facebook-app-id
FACEBOOK_APP_SECRET=demo-facebook-app-secret

INSTAGRAM_CLIENT_ID=demo-instagram-client-id
INSTAGRAM_CLIENT_SECRET=demo-instagram-client-secret

GITHUB_CLIENT_ID=demo-github-client-id
GITHUB_CLIENT_SECRET=demo-github-client-secret

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=demo-email@gmail.com
EMAIL_HOST_PASSWORD=demo-app-password
EMAIL_USE_TLS=True